{
  "name": "twang-signal-diagnostics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-side Signal TLS connection diagnostics",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "npm run build && node --test test/e2e/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.4",
    "playwright": "1.62.1",
    "wrangler": "4.162.0",
    "ws": "8.21.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@getmaapp/signal-wasm": "0.6.6",
    "@mercuryworkshop/epoxy-tls": "2.1.20-1",
    "qrcode": "1.5.4"
  }
}
