{
  "name": "twang-signal-diagnostics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-side Signal TLS connection diagnostics",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "relay": "node relay/server.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@mercuryworkshop/epoxy-tls": "2.1.20-1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  },
  "engines": { "node": ">=22.12.0" }
}
