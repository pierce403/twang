{
  "name": "twang-signal-diagnostics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-side Signal TLS connection diagnostics",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
